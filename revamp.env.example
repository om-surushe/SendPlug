# Copy to revamp.env, generate every secret below, and keep the file mode 0600.
# Compose rejects missing values; the API also rejects documented placeholders.
SENDPLUG_IMAGE_TAG=
POSTGRES_PASSWORD=
# URL-encode POSTGRES_PASSWORD here if it contains URL-reserved characters.
DATABASE_URL=postgresql://sendplug:URL_ENCODED_PASSWORD@postgres:5432/sendplug?schema=public
PUBLIC_ORIGIN=https://sendplug.example
REVAMP_API_PORT=8100
AUTH_SIGNUPS_ENABLED=true
RECOVERY_ADMIN_EMAIL=admin@example.com
RECOVERY_ADMIN_PASSWORD=
SESSION_SECRET=
SEND_BURST_LIMIT=10
SEND_BURST_WINDOW_SECONDS=60
WORKER_CONCURRENCY=5
# UID/GID that own the mode-0600 host secret files (`id -u`, `id -g`).
SENDPLUG_RUNTIME_UID=1000
SENDPLUG_RUNTIME_GID=1000

# Self-host quick start paths. Production cutovers should replace these with
# absolute paths outside the release checkout (see docs/operations/cutover.md).
CREDENTIAL_KEY_FILE_HOST=./secrets/credential_key
TOKEN_PEPPER_FILE_HOST=./secrets/token_pepper

# WorkOS AuthKit is optional. Leave all four empty to use email/password only.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
